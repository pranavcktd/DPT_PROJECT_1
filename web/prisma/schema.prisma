generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model audit_logs {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  department_id BigInt?           @db.UnsignedBigInt
  performed_by  BigInt?           @db.UnsignedBigInt
  table_name    String            @db.VarChar(50)
  record_id     BigInt            @db.UnsignedBigInt
  action        audit_logs_action
  old_data      Json?
  new_data      Json?
  reason        String?           @db.VarChar(500)
  ip_address    String?           @db.VarChar(45)
  user_agent    String?           @db.VarChar(255)
  created_at    DateTime          @default(now()) @db.DateTime(0)
  departments   departments?      @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "fk_audit_department")
  users         users?            @relation(fields: [performed_by], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([performed_by], map: "fk_audit_user")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([department_id], map: "idx_audit_department")
  @@index([table_name, record_id], map: "idx_audit_table_record")
}

model certificate_logs {
  id               BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  department_id    BigInt                            @db.UnsignedBigInt
  certificate_type certificate_logs_certificate_type
  reference_table  String                            @db.VarChar(50)
  reference_id     BigInt                            @db.UnsignedBigInt
  file_format      certificate_logs_file_format      @default(PDF)
  generated_by     BigInt                            @db.UnsignedBigInt
  generated_at     DateTime                          @default(now()) @db.DateTime(0)
  notes            String?                           @db.VarChar(255)
  departments      departments                       @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certlog_department")
  users            users                             @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_certlog_generated_by")

  @@index([generated_by], map: "fk_certlog_generated_by")
  @@index([department_id], map: "idx_certlog_department")
  @@index([reference_table, reference_id], map: "idx_certlog_reference")
}

model contractors {
  id                                  BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  department_id                       BigInt                         @db.UnsignedBigInt
  firm_name                           String                         @db.VarChar(150)
  vendor_code                         String?                        @db.VarChar(30)
  pan_number                          String                         @db.Char(10)
  gstin                               String?                        @db.Char(15)
  gst_state_code                      String?                        @db.Char(2)
  address                             String?                        @db.VarChar(255)
  contact_person                      String?                        @db.VarChar(150)
  phone                               String?                        @db.VarChar(20)
  email                               String?                        @db.VarChar(150)
  bank_name                           String?                        @db.VarChar(150)
  bank_branch                         String?                        @db.VarChar(150)
  account_number                      String?                        @db.VarChar(30)
  ifsc_code                           String?                        @db.VarChar(11)
  account_holder_name                 String?                        @db.VarChar(150)
  status                              contractors_status             @default(ACTIVE)
  created_by                          BigInt?                        @db.UnsignedBigInt
  updated_by                          BigInt?                        @db.UnsignedBigInt
  created_at                          DateTime                       @default(now()) @db.DateTime(0)
  updated_at                          DateTime                       @default(now()) @db.DateTime(0)
  users_contractors_created_byTousers users?                         @relation("contractors_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_contractor_created_by")
  departments                         departments                    @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contractor_department")
  gst_state_codes                     gst_state_codes?               @relation(fields: [gst_state_code], references: [state_code], onDelete: NoAction, onUpdate: NoAction, map: "fk_contractor_gst_state")
  users_contractors_updated_byTousers users?                         @relation("contractors_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_contractor_updated_by")
  payments                            payments[]
  work_experience_certificates        work_experience_certificates[]

  @@unique([department_id, pan_number], map: "uq_contractor_pan_per_dept")
  @@unique([department_id, vendor_code], map: "uq_contractor_vendor_code")
  @@index([created_by], map: "fk_contractor_created_by")
  @@index([gst_state_code], map: "fk_contractor_gst_state")
  @@index([updated_by], map: "fk_contractor_updated_by")
  @@index([department_id], map: "idx_contractor_department")
  @@index([gstin], map: "idx_contractor_gstin")
}

model ddo_details {
  id                         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  department_id              BigInt             @db.UnsignedBigInt
  ddo_name                   String             @db.VarChar(150)
  designation                String             @db.VarChar(150)
  ddo_code                   String?            @db.VarChar(50)
  treasury_registration_code String?            @db.VarChar(50)
  is_primary                 Boolean            @default(true)
  status                     ddo_details_status @default(ACTIVE)
  created_at                 DateTime           @default(now()) @db.DateTime(0)
  updated_at                 DateTime           @default(now()) @db.DateTime(0)
  departments                departments        @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ddo_department")

  @@index([department_id], map: "idx_ddo_department")
}

model department_modules {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  department_id BigInt      @db.UnsignedBigInt
  module_id     Int         @db.UnsignedTinyInt
  is_enabled    Boolean     @default(true)
  enabled_by    BigInt?     @db.UnsignedBigInt
  enabled_at    DateTime    @default(now()) @db.DateTime(0)
  departments   departments @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_deptmod_department")
  users         users?      @relation(fields: [enabled_by], references: [id], onUpdate: NoAction, map: "fk_deptmod_enabled_by")
  modules       modules     @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_deptmod_module")

  @@unique([department_id, module_id], map: "uq_department_module")
  @@index([enabled_by], map: "fk_deptmod_enabled_by")
  @@index([module_id], map: "fk_deptmod_module")
}

model departments {
  id                                     BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_code                            String                         @unique(map: "tenant_code") @db.VarChar(20)
  department_name                        String                         @db.VarChar(150)
  office_address                         String?                        @db.VarChar(255)
  district                               String?                        @db.VarChar(100)
  state                                  String?                        @db.VarChar(100)
  state_code                             String?                        @db.Char(2)
  gstin                                  String?                        @unique(map: "gstin") @db.Char(15)
  pan                                    String?                        @unique(map: "pan") @db.Char(10)
  tan                                    String?                        @db.VarChar(10)
  official_email                         String?                        @db.VarChar(150)
  contact_number                         String?                        @db.VarChar(20)
  logo_path                              String?                        @db.VarChar(255)
  status                                 departments_status             @default(ACTIVE)
  created_by                             BigInt?                        @db.UnsignedBigInt
  created_at                             DateTime                       @default(now()) @db.DateTime(0)
  updated_at                             DateTime                       @default(now()) @db.DateTime(0)
  audit_logs                             audit_logs[]
  certificate_logs                       certificate_logs[]
  contractors                            contractors[]
  ddo_details                            ddo_details[]
  department_modules                     department_modules[]
  users_departments_created_byTousers    users?                         @relation("departments_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_departments_created_by")
  gst_state_codes                        gst_state_codes?               @relation(fields: [state_code], references: [state_code], onDelete: NoAction, onUpdate: NoAction, map: "fk_dept_state_code")
  login_logs                             login_logs[]
  payments                               payments[]
  schemes                                schemes[]
  users_users_department_idTodepartments users[]                        @relation("users_department_idTodepartments")
  work_experience_certificates           work_experience_certificates[]
  works                                  works[]

  @@index([created_by], map: "fk_departments_created_by")
  @@index([state_code], map: "fk_dept_state_code")
}

model gst_state_codes {
  state_code  String        @id @db.Char(2)
  state_name  String        @db.VarChar(100)
  contractors contractors[]
  departments departments[]
}

model login_logs {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt            @db.UnsignedBigInt
  department_id BigInt?           @db.UnsignedBigInt
  login_at      DateTime          @default(now()) @db.DateTime(0)
  logout_at     DateTime?         @db.DateTime(0)
  ip_address    String?           @db.VarChar(45)
  user_agent    String?           @db.VarChar(255)
  status        login_logs_status
  departments   departments?      @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "fk_loginlog_department")
  users         users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_loginlog_user")

  @@index([department_id], map: "fk_loginlog_department")
  @@index([login_at], map: "idx_loginlog_login_at")
  @@index([user_id], map: "idx_loginlog_user")
}

model modules {
  id                      Int                       @id @default(autoincrement()) @db.UnsignedTinyInt
  module_code             String                    @unique(map: "module_code") @db.VarChar(50)
  module_name             String                    @db.VarChar(100)
  description             String?                   @db.VarChar(255)
  created_at              DateTime                  @default(now()) @db.DateTime(0)
  department_modules      department_modules[]
  user_module_permissions user_module_permissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                                BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  department_id                     BigInt                        @db.UnsignedBigInt
  work_id                           BigInt                        @db.UnsignedBigInt
  contractor_id                     BigInt                        @db.UnsignedBigInt
  contractor_name_snapshot          String                        @db.VarChar(150)
  contractor_gstin_snapshot         String?                       @db.Char(15)
  work_name_snapshot                String                        @db.VarChar(200)
  agreement_number_snapshot         String                        @db.VarChar(50)
  agreement_date_snapshot           DateTime                      @db.Date
  invoice_number                    String                        @db.VarChar(50)
  invoice_date                      DateTime                      @db.Date
  base_cost                         Decimal                       @db.Decimal(15, 2)
  gst_rate                          Decimal                       @default(0.00) @db.Decimal(5, 2)
  gst_rate_is_manual                Boolean                       @default(false)
  gst_amount                        Decimal?                      @db.Decimal(15, 2)
  total_bill_value                  Decimal?                      @db.Decimal(15, 2)
  it_tds_rate                       Decimal                       @default(0.00) @db.Decimal(5, 2)
  it_tds_rate_is_manual             Boolean                       @default(false)
  it_tds_amount                     Decimal?                      @db.Decimal(15, 2)
  gst_tds_rate                      Decimal                       @default(0.00) @db.Decimal(5, 2)
  gst_tds_rate_is_manual            Boolean                       @default(false)
  gst_tds_type                      payments_gst_tds_type         @default(NOT_APPLICABLE)
  cgst_tds_amount                   Decimal?                      @db.Decimal(15, 2)
  sgst_tds_amount                   Decimal?                      @db.Decimal(15, 2)
  igst_tds_amount                   Decimal?                      @db.Decimal(15, 2)
  labour_cess_rate                  Decimal                       @default(0.00) @db.Decimal(5, 2)
  labour_cess_rate_is_manual        Boolean                       @default(false)
  labour_cess_amount                Decimal?                      @db.Decimal(15, 2)
  royalty_type                      payments_royalty_type         @default(NOT_APPLICABLE)
  royalty_value                     Decimal                       @default(0.00) @db.Decimal(15, 2)
  royalty_amount                    Decimal?                      @db.Decimal(15, 2)
  stamp_duty_type                   payments_stamp_duty_type      @default(NOT_APPLICABLE)
  stamp_duty_value                  Decimal                       @default(0.00) @db.Decimal(15, 2)
  stamp_duty_amount                 Decimal?                      @db.Decimal(15, 2)
  other_deduction_type              payments_other_deduction_type @default(NOT_APPLICABLE)
  other_deduction_value             Decimal                       @default(0.00) @db.Decimal(15, 2)
  other_deduction_amount            Decimal?                      @db.Decimal(15, 2)
  other_deduction_remarks           String?                       @db.VarChar(255)
  total_deductions                  Decimal?                      @db.Decimal(15, 2)
  net_payable_amount                Decimal?                      @db.Decimal(15, 2)
  cumulative_gross_amount_till_date Decimal                       @default(0.00) @db.Decimal(15, 2)
  treasury_token_number             String?                       @db.VarChar(50)
  treasury_payment_date             DateTime?                     @db.Date
  remarks                           String?                       @db.VarChar(500)
  status                            payments_status               @default(SAVED)
  cancellation_reason               String?                       @db.VarChar(500)
  created_by                        BigInt?                       @db.UnsignedBigInt
  approved_by                       BigInt?                       @db.UnsignedBigInt
  approved_at                       DateTime?                     @db.DateTime(0)
  created_at                        DateTime                      @default(now()) @db.DateTime(0)
  updated_at                        DateTime                      @default(now()) @db.DateTime(0)
  users_payments_approved_byTousers users?                        @relation("payments_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction, map: "fk_payment_approved_by")
  contractors                       contractors                   @relation(fields: [contractor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_contractor")
  users_payments_created_byTousers  users?                        @relation("payments_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_payment_created_by")
  departments                       departments                   @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_department")
  works                             works                         @relation(fields: [work_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_work")

  @@unique([work_id, invoice_number], map: "uq_payment_work_invoice")
  @@index([approved_by], map: "fk_payment_approved_by")
  @@index([created_by], map: "fk_payment_created_by")
  @@index([contractor_id], map: "idx_payment_contractor")
  @@index([department_id], map: "idx_payment_department")
  @@index([status], map: "idx_payment_status")
  @@index([treasury_token_number], map: "idx_payment_treasury_token")
  @@index([work_id], map: "idx_payment_work")
}

model roles {
  id             Int      @id @default(autoincrement()) @db.UnsignedTinyInt
  role_code      String   @unique(map: "role_code") @db.VarChar(30)
  role_name      String   @db.VarChar(60)
  description    String?  @db.VarChar(255)
  is_system_role Boolean  @default(true)
  created_at     DateTime @default(now()) @db.DateTime(0)
  users          users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model schemes {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  department_id     BigInt         @db.UnsignedBigInt
  scheme_name       String         @db.VarChar(200)
  financial_year    String         @db.VarChar(9)
  sanctioned_budget Decimal        @db.Decimal(15, 2)
  description       String?        @db.VarChar(500)
  status            schemes_status @default(ACTIVE)
  created_by        BigInt?        @db.UnsignedBigInt
  created_at        DateTime       @default(now()) @db.DateTime(0)
  updated_at        DateTime       @default(now()) @db.DateTime(0)
  users             users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_scheme_created_by")
  departments       departments    @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_scheme_department")
  works             works[]

  @@unique([department_id, scheme_name, financial_year], map: "uq_scheme_name_per_year")
  @@index([created_by], map: "fk_scheme_created_by")
  @@index([department_id], map: "idx_scheme_department")
}

model user_module_permissions {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt  @db.UnsignedBigInt
  module_id  Int     @db.UnsignedTinyInt
  can_view   Boolean @default(false)
  can_create Boolean @default(false)
  can_edit   Boolean @default(false)
  can_delete Boolean @default(false)
  modules    modules @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_userperm_module")
  users      users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userperm_user")

  @@unique([user_id, module_id], map: "uq_user_module")
  @@index([module_id], map: "fk_userperm_module")
}

model users {
  id                                           BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  department_id                                BigInt?                        @db.UnsignedBigInt
  role_id                                      Int                            @db.UnsignedTinyInt
  name                                         String                         @db.VarChar(150)
  email                                        String                         @unique(map: "email") @db.VarChar(150)
  phone                                        String?                        @db.VarChar(20)
  password_hash                                String                         @db.VarChar(255)
  status                                       users_status                   @default(ACTIVE)
  last_login_at                                DateTime?                      @db.DateTime(0)
  created_by                                   BigInt?                        @db.UnsignedBigInt
  created_at                                   DateTime                       @default(now()) @db.DateTime(0)
  updated_at                                   DateTime                       @default(now()) @db.DateTime(0)
  audit_logs                                   audit_logs[]
  certificate_logs                             certificate_logs[]
  contractors_contractors_created_byTousers    contractors[]                  @relation("contractors_created_byTousers")
  contractors_contractors_updated_byTousers    contractors[]                  @relation("contractors_updated_byTousers")
  department_modules                           department_modules[]
  departments_departments_created_byTousers    departments[]                  @relation("departments_created_byTousers")
  login_logs                                   login_logs[]
  payments_payments_approved_byTousers         payments[]                     @relation("payments_approved_byTousers")
  payments_payments_created_byTousers          payments[]                     @relation("payments_created_byTousers")
  schemes                                      schemes[]
  user_module_permissions                      user_module_permissions[]
  users                                        users?                         @relation("usersTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_users_created_by")
  other_users                                  users[]                        @relation("usersTousers")
  departments_users_department_idTodepartments departments?                   @relation("users_department_idTodepartments", fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_department")
  roles                                        roles                          @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
  work_experience_certificates                 work_experience_certificates[]
  works                                        works[]

  @@index([created_by], map: "fk_users_created_by")
  @@index([role_id], map: "fk_users_role")
  @@index([department_id], map: "idx_users_department")
}

model work_experience_certificates {
  id                       BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  department_id            BigInt      @db.UnsignedBigInt
  work_id                  BigInt      @db.UnsignedBigInt
  contractor_id            BigInt      @db.UnsignedBigInt
  certificate_number       String      @db.VarChar(50)
  stated_completion_date   DateTime?   @db.Date
  actual_completion_date   DateTime?   @db.Date
  sanctioned_value         Decimal     @db.Decimal(15, 2)
  executed_value           Decimal     @db.Decimal(15, 2)
  performance_rating_label String?     @db.VarChar(50)
  performance_rating_score Decimal?    @db.Decimal(3, 1)
  remarks                  String?     @db.VarChar(500)
  issued_by                BigInt      @db.UnsignedBigInt
  issued_at                DateTime    @default(now()) @db.DateTime(0)
  contractors              contractors @relation(fields: [contractor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_wec_contractor")
  departments              departments @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wec_department")
  users                    users       @relation(fields: [issued_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_wec_issued_by")
  works                    works       @relation(fields: [work_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_wec_work")

  @@unique([department_id, certificate_number], map: "uq_wec_certificate_number")
  @@index([contractor_id], map: "fk_wec_contractor")
  @@index([issued_by], map: "fk_wec_issued_by")
  @@index([work_id], map: "idx_wec_work")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model works {
  id                           BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  department_id                BigInt                         @db.UnsignedBigInt
  scheme_id                    BigInt                         @db.UnsignedBigInt
