  departments                  departments                    @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_work_department")
  schemes                      schemes                        @relation(fields: [scheme_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_work_scheme")

  @@index([created_by], map: "fk_work_created_by")
  @@index([department_id], map: "idx_work_department")
  @@index([scheme_id], map: "idx_work_scheme")
}

enum certificate_logs_certificate_type {
  PAYMENT_CERTIFICATE
  WORK_EXPERIENCE_CERTIFICATE
  TAX_LEDGER_REPORT
}

enum audit_logs_action {
  CREATE
  UPDATE
  DELETE
}

enum certificate_logs_file_format {
  PDF
  EXCEL
  CSV
}

enum schemes_status {
  ACTIVE
  CLOSED
}

enum ddo_details_status {
  ACTIVE
  INACTIVE
}

enum login_logs_status {
